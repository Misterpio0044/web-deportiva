DATABASE_URL=postgresql://postgres:changeme@localhost:5432/web_deportiva
JWT_SECRET=change_this_secret_in_production
PORT=3000

# URL pública del frontend (usada para redirigir tras OAuth de Strava)
FRONTEND_URL=http://localhost:5173

# Strava OAuth (crea la app en https://www.strava.com/settings/api)
# Authorization Callback Domain debe ser exactamente: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/strava/callback
STRAVA_AUTH_URL=https://www.strava.com/oauth/authorize
STRAVA_TOKEN_URL=https://www.strava.com/api/v3/oauth/token
STRAVA_API_BASE=https://www.strava.com/api/v3
